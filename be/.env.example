# Backend configuration. Copy to `be/.env` and fill in.
#
#   cp .env.example .env
#
# Real environment variables always win over this file, so deployed settings can
# never be shadowed by a stray .env left in the image.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. DIRECT_URL is accepted as a fallback.
# Supabase pooler example:
#   postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Local example:
#   postgresql://postgres:postgres@localhost:5432/hotel?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel?sslmode=disable

# Signing key for access tokens. Must be at least 32 characters; the server
# refuses to start otherwise, and there is no insecure fallback.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# development (default) or production. Production enables JSON logging and
# requires CORS_ORIGIN to be set to an explicit, non-wildcard list.
APP_ENV=development

# Port to listen on.
PORT=8080

# Comma-separated list of browser origins allowed to call the API.
# Leave empty in development to reflect whatever origin Vite is serving from.
CORS_ORIGIN=http://localhost:5173

# How long an access token stays valid. Accepts a Go duration (24h, 30m) or
# bare seconds.
JWT_TTL=24h

# Run the idempotent seeder on boot. Defaults to true outside production.
SEED=true

# Password given to the seeded demo accounts (admin@example.com and
# user@example.com). Defaults to "demo1234" in development.
# Leave empty to seed rooms and reference data without creating any logins.
SEED_DEMO_PASSWORD=demo1234

# Log every SQL statement. Useful when debugging a query, noisy otherwise.
LOG_SQL=false

# Server timeouts. Accept Go durations or bare seconds.
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
