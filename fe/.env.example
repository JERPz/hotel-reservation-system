# Frontend configuration. Copy to `fe/.env` and adjust if needed.
#
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser. Never put a
# secret in this file: everything here is bundled into the shipped JavaScript
# and is readable by anyone who loads the page.

# Base URL of the Go API, with no trailing slash.
VITE_API_BASE_URL=http://localhost:8080
