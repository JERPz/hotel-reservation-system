# Production build settings. Vite loads this automatically for `vite build`.
#
# Committed on purpose: this is the public address of the API, not a secret, and
# keeping it here means a deploy cannot accidentally ship a bundle pointing at
# localhost. Everything in a VITE_ variable ends up readable in the shipped
# JavaScript, so never put a credential in this file.

VITE_API_BASE_URL=https://hotel-reservation-system-ip8o.onrender.com
